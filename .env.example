CLR_OLLAMA_BASE_URL=http://localhost:11434/v1
CLR_MODEL=mistral-nemo
CLR_HOST=127.0.0.1
CLR_PORT=8000
CLR_LOG_LEVEL=info

# Optional, independent secrets — either one turns auth on for /api/v1/*
# (except /health). Leave both unset to keep auth off (fine for local-only use).

# For scripts/curl — send as the X-API-Key header.
CLR_API_KEY=

# For the browser UI — typed into the login screen, exchanged for a session
# cookie. Pick something memorable since it's typed by hand on other devices.
CLR_LOGIN_PASSWORD=

# Gmail app-password auth (IMAP) — generate at myaccount.google.com/apppasswords
# Only the address goes here; the app password is entered at the terminal
# prompt when you run `python main.py` and is never written to disk.
CLR_GMAIL_ADDRESS=you@gmail.com